s6.png
s7.png
s_*.png
screenshot_*.png
screen_home.png
player.png
player.xml
nul
ui*.xml
webdav_response.xml
webdav_subdir.xml
u1.xml
u2.xml
u3.xml
ui.xml
ui3.xml
*.py
*.json
verify_*.py
test_*.py
expected_*.py
expected_*.json
*.log
__pycache__/
*.bak

# 例外：tools/ 下的取数与实测脚本是交付物，必须入库。
# 上面的 *.py / test_*.py 是无差别的临时脚本规则，不排除掉的话
# fetch_stations.py / station_probe.py 及其测试全部不会出现在仓库里，
# 下次扩充电台或回填标签只能重新人肉摸一遍。
!tools/*.py
!tools/*.json

# 但体检工具的原始转储不入库：它是每次重跑都会变的 180KB 测量集，
# 人读的结论 tools/recheck_report.txt 才是要留在仓里的证据。
tools/recheck_report.json
# 同理：云听全站扫描的原始转储（约 900 次请求的产物）只当本地缓存，
# 结论 tools/epg_match_report.txt 入库。映射表本身在 assets/epg_stations.json。
tools/epg_scan.json

# 软著与上架申报材料：本地留档，绝不入库。本仓库是公开 GitHub 仓，
# 而这里头放的是签章页（手写签名）、本人身份信息、服务器部署笔记，
# 以及从本地真值源码生成的 source_code_first_30pages.txt ——
# 已核实它含真实主机 webdav.123pan.cn 且无占位符，一次 `git add doc/` 就会泄露凭证。
doc/store_assets/

# iptv 清单由 tools/iptv_sync.ps1 生成，但必须入库（与 radio_stations.json 同等对待：
# 它是运行时读取的产品数据，不是中间产物）。上面 L52 的全局 *.json 会把它静默拦住，
# 造成“提交成功但文件不在仓库里”，别人拉下来闸门测试必炸（本轮真实撞过一次）。
# 这里用目录级例外而不是只点 iptv_channels.json 一个文件：
# 否则下一个新增的 assets json 仍会被静默挡住，把同一个坑重演一遍。
!app/src/main/assets/*.json
